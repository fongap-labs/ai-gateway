{
  "name": "ai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
    // Cron runs in UTC (Cloudflare Workers does not support timezone in cron expressions).
    // 0 3 * * * = 03:00 UTC daily.
  }
}

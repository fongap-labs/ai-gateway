{
  // Operator-specific configuration. Copy to wrangler.user.jsonc (gitignored) and fill in.
  // This file is inherited by wrangler.jsonc via "inherit": "wrangler.user.jsonc"

  // Production custom domain (optional). If set, the worker is attached to this domain.
  // "routes": [
  //   {
  //     "pattern": "api.example.com",
  //     "custom_domain": true
  //   }
  // ],

  // After the private inference center and its contract tests are deployed,
  // the gateway can bind it internally. Do not enable this during PR #209.
  // "services": [{ "binding": "AIG_INFERENCE_SERVICE", "service": "ai-inference-center" }],
  // "services": [{ "binding": "AIG_GENERATION_SERVICE", "service": "ai-generation-center" }],
  // "vars": { "AIG_GENERATION_ACTIVE": "true" },

  // Production-specific vars that differ from wrangler.jsonc defaults
  // "vars": {
  //   "AIG_PUBLIC_URL": "https://api.example.com",
  //   "AIG_CORS_ORIGIN": "https://app.example.com"
  // }
}
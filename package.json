{
  "name": "ai-gateway",
  "private": true,
  "description": "AI API gateway on Cloudflare Workers that turns fragmented, failure-prone providers and keys into one stable OpenAI/Anthropic-compatible endpoint — maximizing low-cost capacity through smart routing and tiered failover.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run validate:merge",
    "check": "node scripts/check-syntax.mjs",
    "check:links": "node scripts/link-check.mjs",
    "check:docs": "node scripts/docs-check.mjs",
    "test": "node scripts/test.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "lint": "npx biome check .",
    "typecheck": "npx tsc --noEmit",
    "validate:merge": "npm run check && npm run check:deployment-config && npm run migrations:check && npm run security:scan && npm run check:docs && npm run lint && npm run typecheck && npm run check:links",
    "validate:deploy": "npm run check && npm run check:deployment-config && npm run migrations:check && npm run security:scan && npm run check:docs && npm run lint && npm run typecheck && npm run check:links",
    "dev": "node scripts/cloudflare-wrangler.mjs dev",
    "deploy": "node scripts/cloudflare-wrangler.mjs deploy --keep-vars",
    "tail": "node scripts/cloudflare-wrangler.mjs tail",
    "cf:login": "node scripts/cloudflare-wrangler.mjs login",
    "cf:whoami": "node scripts/cloudflare-wrangler.mjs whoami",
    "check:deploy": "node scripts/cloudflare-wrangler.mjs deploy --dry-run --keep-vars --outdir .wrangler-dry-run",
    "check:deployment-config": "node scripts/deployment-config-check.mjs",
    "migrations:check": "node scripts/migrations-check.mjs",
    "config:check": "node scripts/config-cli.mjs check",
    "config:show": "node scripts/config-cli.mjs show",
    "config:diff": "node scripts/config-cli.mjs diff",
    "discovery:check": "node scripts/provider-discovery.mjs check-snapshot scripts/provider-discovery/samples/catalog.example.json",
    "discovery:summary": "node scripts/provider-discovery.mjs summary scripts/provider-discovery/samples/catalog.example.json"
  },
  "keywords": [
    "ai-gateway",
    "llm-gateway",
    "llm-router",
    "cloudflare-workers",
    "claude-code",
    "openai-api",
    "openai-compatible",
    "anthropic-api",
    "load-balancing",
    "rate-limiting",
    "multi-provider"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}

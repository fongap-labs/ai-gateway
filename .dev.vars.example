# Local development only. Copy to .dev.vars (gitignored); never commit real credentials.
# Required per node: id, provider, base_url, models.
# Config and Secret shard suffixes are independent; credentials resolve by Tier + node id.

AIG_ACCESS_KEY_AIR="replace-with-a-long-random-air-key"
AIG_ACCESS_MODELS_AIR="general-air"

AIG_TIER1_NODES_01='[
  {"id":"nvidia-01","provider":"nvidia","base_url":"https://integrate.api.nvidia.com/v1","priority":10,"models":{"general-air":"deepseek-ai/deepseek-v3.1","code-pro":"qwen/qwen3-coder-480b"}},
  {"id":"nvidia-02","provider":"nvidia","base_url":"https://integrate.api.nvidia.com/v1","priority":10,"models":{"general-air":"deepseek-ai/deepseek-v3.1"}},
  {"id":"glm-01","provider":"zhipu","base_url":"https://open.bigmodel.cn/api/paas/v4","priority":20,"models":{"code-max":"glm-4.7"}}
]'

# Optional example for local credentials; replace placeholders outside the repository.
# AIG_TIER1_CREDENTIALS_01='{"nvidia-01":"replace-key","nvidia-02":"replace-key","glm-01":"replace-key"}'

# Defaults live in src/config/runtime-vars.ts; uncomment only explicit local overrides.
# AIG_UPSTREAM_HEADER_TIMEOUT_MS="15000"     # default: 15 s
# AIG_FIRST_EVENT_TIMEOUT_MS="30000"         # default: 30 s
# AIG_STREAM_IDLE_TIMEOUT_MS="120000"        # default: 120 s
# AIG_RATE_LIMIT_COOLDOWN_MS="30000"         # default: 30 s (Tier 2/3 fallback wait; Tier 1 uses the ladder below)
# AIG_AUTH_FAILURE_COOLDOWN_MS="3600000"        # default: 1 h
# AIG_REQUEST_BODY_MAX_BYTES="20971520"              # default: 20 MB
# AIG_FAILOVER_BUDGET_MS="60000"             # default: 60 s
# AIG_HEDGE_DELAY_MS="3000"                  # default: 3 s
# AIG_REQUEST_HEDGE_MAX="1"             # default: 1
# AIG_ISOLATE_MAX_IN_FLIGHT="0"                 # default: 0 (disabled); set positive cap only when needed
# AIG_CHUNKED_BODY_MAX_BYTES="524288"           # default: 512 KB; charge/read cap for bodies without Content-Length
# AIG_STREAM_MAX_ATTEMPTS="2"                   # default: 2; streaming logical-attempt cap (admission stack)
# AIG_NONSTREAM_MAX_ATTEMPTS="3"                # default: 3; buffered logical-attempt cap (admission stack)
# AIG_ACCESS_KEY_RPM="600"                  # default: 0 (disabled); set a positive value to cap each group per minute
# AIG_AUTH_ATTEMPT_RPM="60"                 # default: 60 failed auth attempts per fingerprint; 0 disables
# AIG_EDGE_CACHE_TTL_SEC="14400"            # default: 4 h (0 = disabled)
# AIG_TOKEN_D1_SAMPLE_PCT="100"                 # default: 100; cost guards use 1 (0 = no per-model token detail)
# AIG_AFFINITY_WRITE="1"                        # default: 1; cost guards switch the default to 0
# AIG_AFFINITY_READ_TIMEOUT_MS="50"             # default: 50 ms; hot-path guards switch the default to 15
# AIG_TIER1_PROBE_TIMEOUT_MS="10000"            # default: 10 s
# AIG_STREAM_GUARD_PREFIX_BYTES="65536"         # default: 64 KB
# AIG_CONVERSION_MAX_EVENTS="400"               # default: 400
# AIG_CONVERSION_MAX_BYTES="131072"             # default: 128 KB (translated output)
# AIG_CONVERSION_MAX_TOOL_EVENTS="200"          # default: 200
# AIG_CONVERSION_MAX_TOOL_ARG_BYTES="65536"     # default: 64 KB per open tool call
# AIG_CONVERSION_NONSTREAM_MAX_BYTES="131072"   # default: 128 KB (collected-object path)
# AIG_CONVERSION_MAX_OUTPUT_TOKENS="0"          # default: 0 (reported output-token ceiling disabled)

# Optional IR protocol fallback mapping.
# AIG_PROTOCOL_FALLBACKS='{"anthropic:messages":["openai:chat_completions","openai:responses"],"openai:chat_completions":["anthropic:messages","openai:responses"],"openai:responses":["anthropic:messages","openai:chat_completions"]}'
